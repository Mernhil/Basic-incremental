{
  "name": "basic-incremental",
  "version": "0.4.3",
  "description": "Basic incremental - a Windows desktop incremental game",
  "private": true,
  "author": "Mernhil",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && node scripts/check-release-bundle.mjs out",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "lint": "eslint . && prettier --check . && node scripts/check-design.mjs && node scripts/check-workflow.mjs",
    "design:check": "node scripts/check-design.mjs && node scripts/check-workflow.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "format": "prettier --write .",
    "sim": "tsx scripts/sim/cli.ts",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always",
    "design:build": "node design/explorations/build.mjs",
    "design:shoot": "node design/explorations/shoot.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/spectral": "^5.3.0",
    "@types/node": "^26.6.6",
    "break_eternity.js": "^2.1.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
